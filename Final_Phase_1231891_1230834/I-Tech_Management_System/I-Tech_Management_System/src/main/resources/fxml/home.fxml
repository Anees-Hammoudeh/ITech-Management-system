                    <Label fx:id="alertOneLabel" style="-fx-text-fill: #333333; -fx-font-weight: bold;" text="• Pending payments: 0" />
                    <Label fx:id="alertTwoLabel" style="-fx-text-fill: #333333; -fx-font-weight: bold;" text="• Low stock records: 0" />
                    <Label fx:id="alertThreeLabel" style="-fx-text-fill: #555555;" text="• Total items in warehouse: 0" />
                </VBox>

