                                <TableColumn fx:id="paymentAmountColumn" prefWidth="132.0" text="Amount" />
                                <TableColumn fx:id="paymentMethodColumn" prefWidth="132.0" text="Method" />
                                <TableColumn fx:id="paymentDateColumn" prefWidth="155.0" text="Date" />
                            </columns>
                        </TableView>
                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>
