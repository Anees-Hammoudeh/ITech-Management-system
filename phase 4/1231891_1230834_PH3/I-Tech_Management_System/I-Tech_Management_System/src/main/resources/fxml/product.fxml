<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.itech_management_system.ProductController" style="-fx-background-color: #101820; -fx-font-family: 'Segoe UI';">

    <padding>
        <Insets top="18" right="24" bottom="18" left="24"/>
    </padding>

    <top>

        <VBox spacing="3">

            <Label text="I-Tech Product Dashboard" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Add, update, delete, search, and manage products" style="-fx-text-fill: #9fb3c8; -fx-font-size: 13px;"/>

        </VBox>

    </top>

    <center>

        <HBox spacing="18" style="-fx-padding: 18 0 0 0;">

            <VBox spacing="14" prefWidth="330" style="-fx-background-color: #1b2733; -fx-background-radius: 18; -fx-padding: 20;">

                <Label text="Product Details" style="-fx-text-fill: #f2aa4c; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Label text="Product Name" style="-fx-text-fill: white;"/>

                <TextField fx:id="nameField" promptText="Enter name" style="-fx-background-color: #263545; -fx-text-fill: white; -fx-prompt-text-fill: #8296aa; -fx-background-radius: 10; -fx-padding: 9;"/>

                <Label text="Product Price" style="-fx-text-fill: white;"/>

                <TextField fx:id="priceField" promptText="Enter price" style="-fx-background-color: #263545; -fx-text-fill: white; -fx-prompt-text-fill: #8296aa; -fx-background-radius: 10; -fx-padding: 9;"/>

                <Label text="Product ID" style="-fx-text-fill: white;"/>

                <TextField fx:id="idField" promptText="For update/delete" style="-fx-background-color: #263545; -fx-text-fill: white; -fx-prompt-text-fill: #8296aa; -fx-background-radius: 10; -fx-padding: 9;"/>

                <Label text="Product Model" style="-fx-text-fill: white;"/>

                <TextField fx:id="modelField" promptText="Enter model" style="-fx-background-color: #263545; -fx-text-fill: white; -fx-prompt-text-fill: #8296aa; -fx-background-radius: 10; -fx-padding: 9;"/>

                <GridPane hgap="8" vgap="8">

                    <Button text="Add Product" onAction="#doSave" mnemonicParsing="false" prefWidth="135" style="-fx-background-color: #f2aa4c; -fx-text-fill: #101820; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                    <Button text="Show Products" onAction="#doShow" mnemonicParsing="false" prefWidth="135" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Button text="Update" onAction="#doUpdate" mnemonicParsing="false" prefWidth="135" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Button text="Delete" onAction="#doDelete" mnemonicParsing="false" prefWidth="135" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Button text="Clear" onAction="#clearFields" mnemonicParsing="false" prefWidth="278" style="-fx-background-color: #6c7a89; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>

                </GridPane>

                <Label fx:id="messageLabel" style="-fx-text-fill: #f2aa4c; -fx-font-weight: bold; -fx-font-size: 13px;"/>

            </VBox>

            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #1b2733; -fx-background-radius: 16; -fx-padding: 14;">

                    <TextField fx:id="searchField" promptText="Search by ID or Name" prefWidth="260" style="-fx-background-color: #263545; -fx-text-fill: white; -fx-prompt-text-fill: #8296aa; -fx-background-radius: 10; -fx-padding: 8;"/>

                    <Button text="Search" onAction="#doSearch" mnemonicParsing="false" prefWidth="100" style="-fx-background-color: #f2aa4c; -fx-text-fill: #101820; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Products List" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                </HBox>

                <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #1b2733; -fx-border-color: #263545; -fx-border-radius: 14; -fx-background-radius: 14;">

                    <columns>

                        <TableColumn fx:id="idColumn" text="ID" prefWidth="90"/>

                        <TableColumn fx:id="nameColumn" text="Product Name" prefWidth="260"/>

                        <TableColumn fx:id="modelColumn" text="Model" prefWidth="200"/>

                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="140"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>

    </center>

</BorderPane>