                        <Label fx:id="purchasesCountLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="0" />
                    </VBox>
                    <VBox prefWidth="190" spacing="6" style="-fx-background-color:white; -fx-background-radius:14; -fx-border-color:#dddddd; -fx-border-radius:14; -fx-border-width:0.5; -fx-padding:18;">
