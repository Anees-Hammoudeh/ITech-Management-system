<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.itech_management_system.InventoryController"
            style="-fx-background-color: #f0f0f0; -fx-font-family: 'Segoe UI';">

    <top>
        <HBox style="-fx-background-color: #3a3a3a; -fx-padding: 0 20 0 20; -fx-alignment: CENTER_LEFT; -fx-min-height: 48px; -fx-pref-height: 48px;">
            <Label text="I-Tech" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 28 0 0;"/>
            <Button text="Dashboard" onAction="#openDashboard" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Products" onAction="#openProducts" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Customers" onAction="#openCustomers" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Suppliers" onAction="#openSuppliers" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Employees" onAction="#openEmployees" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Inventory" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 14 12 10 12; -fx-border-color: transparent transparent #888888 transparent; -fx-border-width: 0 0 3 0;"/>
            <Button text="Sales" onAction="#openSales" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Purchases" onAction="#openPurchases" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Reports" onAction="#openReports" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 28;">

                <HBox alignment="CENTER"><Label text="Inventory Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                <HBox spacing="15">
                    <VBox prefWidth="215" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label fx:id="totalProductsLabel" text="Total Products: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                    </VBox>
                    <VBox prefWidth="215" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label fx:id="totalUnitsLabel" text="Total Units: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                    </VBox>
                    <VBox prefWidth="215" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label fx:id="totalSectionsLabel" text="Storage Sections: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                    </VBox>
                    <VBox prefWidth="215" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <Label fx:id="lowStockLabel" text="Used Storage: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                    </VBox>
                </HBox>

                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <Label text="Inventory Alerts" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>
                    <Label fx:id="alertLowStockLabel" text="Loading..." style="-fx-text-fill: #555555; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="alertEmptyLabel" text="Loading..." style="-fx-text-fill: #555555; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Button text="Refresh Alerts" onAction="#showAlerts" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <HBox alignment="CENTER"><Label text="Stock Overview" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                    <HBox spacing="10">
                        <ComboBox fx:id="searchTypeCombo" prefWidth="160" style="-fx-background-color: #f8f8f8;"/>
                        <TextField fx:id="searchField" promptText="Search here..." prefWidth="275" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button text="Search" onAction="#searchInventory" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Show All" onAction="#showStock" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Clear" onAction="#clearSearch" style="-fx-background-color: #e8e8e8; -fx-font-weight: bold; -fx-text-fill: #555555; -fx-background-radius: 8;"/>
                    </HBox>

                    <Label fx:id="searchMessageLabel" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>

                    <TableView fx:id="stockTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="productIdColumn" text="Product ID" prefWidth="105"/>
                            <TableColumn fx:id="productNameColumn" text="Product Name" prefWidth="255"/>
                            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="155"/>
                            <TableColumn fx:id="brandColumn" text="Brand" prefWidth="155"/>
                            <TableColumn fx:id="stockColumn" text="Stock" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <HBox alignment="CENTER"><Label text="Storage Capacity" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                    <HBox spacing="8">
                        <TextField fx:id="capacitySearchField" promptText="Search section..." prefWidth="250" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button text="Search" onAction="#searchCapacity" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Show All" onAction="#showCapacity" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Clear" onAction="#clearCapacitySearch" style="-fx-background-color: #e8e8e8; -fx-font-weight: bold; -fx-text-fill: #555555; -fx-background-radius: 8;"/>
                    </HBox>

                    <Label fx:id="capacityMessageLabel" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>

                    <TableView fx:id="capacityTable" prefHeight="260">
                        <columns>
                            <TableColumn fx:id="sectionIdColumn" text="Section ID" prefWidth="90"/>
                            <TableColumn fx:id="sectionNameColumn" text="Section Name" prefWidth="185"/>
                            <TableColumn fx:id="sectionTypeColumn" text="Type" prefWidth="125"/>
                            <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="95"/>
                            <TableColumn fx:id="usedQuantityColumn" text="Used Size" prefWidth="105"/>
                            <TableColumn fx:id="capacityPercentColumn" text="Used %" prefWidth="105"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- transfer stock between sections -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <HBox alignment="CENTER"><Label text="Transfer Stock" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Product:" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                        <ComboBox fx:id="transferProductCombo" prefWidth="250" promptText="Select product" style="-fx-background-color: #f8f8f8;"/>
                        <Label text="From:" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                        <ComboBox fx:id="transferFromCombo" prefWidth="200" promptText="Source section" style="-fx-background-color: #f8f8f8;"/>
                        <Label text="To:" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                        <ComboBox fx:id="transferToCombo" prefWidth="200" promptText="Destination section" style="-fx-background-color: #f8f8f8;"/>
                        <Label text="Qty:" style="-fx-font-weight: bold; -fx-text-fill: #444444;"/>
                        <TextField fx:id="transferQuantityField" promptText="Quantity" prefWidth="80" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button text="Transfer" onAction="#doTransfer" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Clear" onAction="#clearTransfer" style="-fx-background-color: #e8e8e8; -fx-font-weight: bold; -fx-text-fill: #555555; -fx-background-radius: 8;"/>
                    </HBox>

                    <Label fx:id="transferMessageLabel" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                    <HBox alignment="CENTER"><Label text="Stock Movements" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                    <HBox spacing="8">
                        <ComboBox fx:id="movementSearchTypeCombo" prefWidth="155" style="-fx-background-color: #f8f8f8;"/>
                        <TextField fx:id="movementSearchField" promptText="Search movements..." prefWidth="255" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Button text="Search" onAction="#searchMovements" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Show All" onAction="#showMovements" style="-fx-background-color: #3a3a3a; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-radius: 8;"/>
                        <Button text="Clear" onAction="#clearMovementSearch" style="-fx-background-color: #e8e8e8; -fx-font-weight: bold; -fx-text-fill: #555555; -fx-background-radius: 8;"/>
                    </HBox>

                    <Label fx:id="movementMessageLabel" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>

                    <TableView fx:id="movementTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="movementIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="movementProductColumn" text="Product" prefWidth="255"/>
                            <TableColumn fx:id="movementTypeColumn" text="Type" prefWidth="115"/>
                            <TableColumn fx:id="movementQuantityColumn" text="Quantity" prefWidth="100"/>
                            <TableColumn fx:id="sourceColumn" text="From" prefWidth="175"/>
                            <TableColumn fx:id="destinationColumn" text="To" prefWidth="175"/>
                            <TableColumn fx:id="movementDateColumn" text="Date" prefWidth="125"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>