                        <Label fx:id="monthSalesLabel" style="-fx-font-size: 28px; -fx-font-weight:bold; -fx-text-fill:#222222;" text="0" />
                  <Label layoutX="31.0" layoutY="31.0" style="-fx-font-size: 14px; -fx-text-fill:#777777;" text="Sales last 6 months" />
                        <LineChart fx:id="monthSalesChart" animated="false" createSymbols="true" legendVisible="false" prefHeight="259.0" prefWidth="357.0" style="-fx-padding: 0;">
