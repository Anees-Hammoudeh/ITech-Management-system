<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.itech_management_system.EmployeeController" style="-fx-background-color: #f0f0f0; -fx-font-family: 'Segoe UI';">

    <top>
        <HBox style="-fx-background-color: #3a3a3a; -fx-padding: 0 20 0 20; -fx-alignment: CENTER_LEFT; -fx-min-height: 48px; -fx-pref-height: 48px;">
            <Label text="I-Tech" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 28 0 0;"/>
            <Button text="Dashboard" onAction="#openDashboard" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Products" onAction="#openProducts" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Customers" onAction="#openCustomers" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Suppliers" onAction="#openSuppliers" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Employees" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 14 12 10 12; -fx-border-color: transparent transparent #888888 transparent; -fx-border-width: 0 0 3 0;"/>
            <Button text="Inventory" onAction="#openInventory" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Sales" onAction="#openSales" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Purchases" onAction="#openPurchases" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
            <Button text="Reports" onAction="#openReports" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-padding: 14 12 12 12; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 28;">

                <HBox alignment="CENTER"><Label text="Employee Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>

                <HBox spacing="18">
                    <VBox spacing="10" prefWidth="330" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Employee Data" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <Label text="Employee ID" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="idField" promptText="for update/delete" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="First Name" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="firstNameField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Last Name" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="lastNameField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Position" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="positionField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Salary" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="salaryField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Supervisor ID (optional)" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="supervisorIdField" promptText="leave empty if no supervisor" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Phone" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="mainPhoneField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <GridPane hgap="8" vgap="8">
                            <Button text="Add" onAction="#doSave" prefWidth="145" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Update" onAction="#doUpdate" prefWidth="145" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Delete" onAction="#doDelete" prefWidth="145" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Clear" onAction="#clearFields" prefWidth="145" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: #e8e8e8; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </GridPane>
                        <Label fx:id="messageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox spacing="10">
                            <ComboBox fx:id="searchTypeCombo" prefWidth="155" style="-fx-background-color: #f8f8f8;"/>
                            <TextField fx:id="searchField" promptText="Enter search value" prefWidth="230" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            <Button text="Search" onAction="#doSearch" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show All" onAction="#doShow" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                        <Label fx:id="searchMessageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                        <Label fx:id="employeeCountLabel" text="Total Employees: 0" style="-fx-text-fill: #888888; -fx-font-weight: bold;"/>
                        <TableView fx:id="employeeTable" prefHeight="320">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="130"/>
                                <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="130"/>
                                <TableColumn fx:id="positionColumn" text="Position" prefWidth="130"/>
                                <TableColumn fx:id="salaryColumn" text="Salary" prefWidth="100"/>
                                <TableColumn fx:id="supervisorIdColumn" text="Sup ID" prefWidth="70"/>
                                <TableColumn fx:id="supervisorNameColumn" text="Supervisor Name" prefWidth="160"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <VBox spacing="10" prefWidth="330" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Employee Phone Data" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <Label text="Employee ID" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="phoneEmployeeIdField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <Label text="Phone" style="-fx-text-fill: #555555;"/>
                        <TextField fx:id="phoneField" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                        <GridPane hgap="8" vgap="8">
                            <Button text="Add Phone" onAction="#addPhone" prefWidth="145" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Delete Phone" onAction="#deletePhone" prefWidth="145" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show Phones" onAction="#showPhones" prefWidth="298" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" style="-fx-background-color: #e8e8e8; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Clear Phone" onAction="#clearPhoneFields" prefWidth="298" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2" style="-fx-background-color: #e8e8e8; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </GridPane>
                        <Label fx:id="phoneMessageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Employee Phones" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <HBox spacing="10">
                            <TextField fx:id="phoneSearchField" promptText="Search phones by employee name" prefWidth="300" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            <Button text="Search Phone" onAction="#searchPhones" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show All Phones" onAction="#showPhones" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                        <TableView fx:id="phoneTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="phoneEmployeeIdColumn" text="Employee ID" prefWidth="120"/>
                                <TableColumn fx:id="phoneEmployeeNameColumn" text="Employee Name" prefWidth="260"/>
                                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="180"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Work Summary" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <HBox spacing="10">
                            <TextField fx:id="workSearchField" promptText="Search by employee name" prefWidth="300" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            <Button text="Search" onAction="#searchWork" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show All" onAction="#showWork" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                        <Label fx:id="workMessageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                        <TableView fx:id="workTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="workEmployeeIdColumn" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="workEmployeeNameColumn" text="Employee Name" prefWidth="200"/>
                                <TableColumn fx:id="positionWorkColumn" text="Position" prefWidth="130"/>
                                <TableColumn fx:id="managerWorkColumn" text="Manager" prefWidth="180"/>
                                <TableColumn fx:id="salesCountColumn" text="Sales" prefWidth="80"/>
                                <TableColumn fx:id="purchasesCountColumn" text="Purchases" prefWidth="100"/>
                                <TableColumn fx:id="totalRecordsColumn" text="Total" prefWidth="80"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Employee Sales" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <HBox spacing="10">
                            <TextField fx:id="employeeSalesSearchField" promptText="Search by employee name" prefWidth="300" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            <Button text="Search" onAction="#searchEmployeeSales" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show All" onAction="#showEmployeeSales" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                        <Label fx:id="employeeSalesMessageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                        <TableView fx:id="employeeSalesTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="esEmployeeIdColumn" text="Emp ID" prefWidth="80"/>
                                <TableColumn fx:id="esEmployeeNameColumn" text="Employee Name" prefWidth="200"/>
                                <TableColumn fx:id="esSaleIdColumn" text="Sale ID" prefWidth="80"/>
                                <TableColumn fx:id="esCustomerNameColumn" text="Customer" prefWidth="200"/>
                                <TableColumn fx:id="esProductsSoldColumn" text="Products" prefWidth="90"/>
                                <TableColumn fx:id="esSaleTotalColumn" text="Sale Total" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 14; -fx-border-width: 0.5;">
                        <HBox alignment="CENTER"><Label text="Employee Purchases" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;"/></HBox>
                        <HBox spacing="10">
                            <TextField fx:id="employeePurchaseSearchField" promptText="Search by employee name" prefWidth="300" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                            <Button text="Search" onAction="#searchEmployeePurchases" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button text="Show All" onAction="#showEmployeePurchases" style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                        <Label fx:id="employeePurchaseMessageLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                        <TableView fx:id="employeePurchaseTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="epEmployeeIdColumn" text="Emp ID" prefWidth="80"/>
                                <TableColumn fx:id="epEmployeeNameColumn" text="Employee Name" prefWidth="200"/>
                                <TableColumn fx:id="epPurchaseIdColumn" text="Purchase ID" prefWidth="100"/>
                                <TableColumn fx:id="epSupplierNameColumn" text="Supplier" prefWidth="200"/>
                                <TableColumn fx:id="epProductsPurchasedColumn" text="Products" prefWidth="90"/>
                                <TableColumn fx:id="epPurchaseTotalColumn" text="Total" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
