<BorderPane style="-fx-background-color:#f0f0f0; -fx-font-family:'Segoe UI';" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.itech_management_system.HomeController">
    <top>
