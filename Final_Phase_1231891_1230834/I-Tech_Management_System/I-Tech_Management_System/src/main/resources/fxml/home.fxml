                                <TableColumn fx:id="saleIdColumn" prefWidth="89.0" text="ID" />
                                <TableColumn fx:id="saleCustomerColumn" prefWidth="300.0" text="Customer" />
                                <TableColumn fx:id="saleEmployeeColumn" prefWidth="226.0" text="Employee" />
                                <TableColumn fx:id="saleDateColumn" prefWidth="126.0" text="Date" />
                                <TableColumn fx:id="saleTotalColumn" prefWidth="159.0" text="Total" />
                            </columns>
                        </TableView>
                    </VBox>

                </HBox>

                <HBox spacing="18">

                    <VBox prefHeight="0.0" prefWidth="0.0" spacing="10" style="-fx-background-color:white; -fx-background-radius:14; -fx-border-color:#dddddd; -fx-border-radius:14; -fx-border-width:0.5; -fx-padding:20;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Top Products" />
                        <TableView fx:id="topProductsTable" maxWidth="667.0" prefHeight="230">
                            <columns>
                                <TableColumn fx:id="topProductColumn" prefWidth="260" text="Product" />
                                <TableColumn fx:id="topSoldColumn" prefWidth="138.0" text="Sold Qty" />
                                <TableColumn fx:id="topRevenueColumn" prefWidth="230.0" text="Revenue" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox prefWidth="430" spacing="10" style="-fx-background-color:white; -fx-background-radius:14; -fx-border-color:#dddddd; -fx-border-radius:14; -fx-border-width:0.5; -fx-padding:20;">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Pending Payments" />
                        <TableView fx:id="paymentsTable" maxWidth="450.0" minWidth="500.0" prefHeight="230.0" prefWidth="450.0">
