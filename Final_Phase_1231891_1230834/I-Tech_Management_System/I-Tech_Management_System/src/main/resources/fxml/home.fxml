                        <Label fx:id="revenueLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="0.00" />
                    </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox prefWidth="235" spacing="6" style="-fx-background-color:white; -fx-background-radius:14; -fx-border-color:#dddddd; -fx-border-radius:14; -fx-border-width:0.5; -fx-padding:18;">
                        <Label fx:id="totalStockLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Total Stock: 0" />
