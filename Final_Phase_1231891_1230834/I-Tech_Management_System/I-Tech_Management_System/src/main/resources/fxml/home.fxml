                <HBox>
                    <VBox>
                        <Label style="-fx-text-fill: #555555;" />
                    </VBox>
                     <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="37.0" style="-fx-text-fill: #222222; -fx-font-size: 30px; -fx-font-weight: bold;" text="Dashboard" />
                </HBox>

                <HBox spacing="14">
                    <VBox prefWidth="190" spacing="6" style="-fx-background-color:white; -fx-background-radius:14; -fx-border-color:#dddddd; -fx-border-radius:14; -fx-border-width:0.5; -fx-padding:18;">
                        <Label style="-fx-text-fill: #555555;" text="Products" />
                        <Label fx:id="productsCountLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="0" />
