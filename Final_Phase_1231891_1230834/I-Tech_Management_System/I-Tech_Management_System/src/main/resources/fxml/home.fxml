                  <Label layoutX="31.0" layoutY="31.0" style="-fx-font-size: 14px; -fx-text-fill:#777777;" text="Profit last 6 months" />
                        <LineChart fx:id="monthProfitChart" animated="false" createSymbols="true" legendVisible="false" prefHeight="262.0" prefWidth="356.0" style="-fx-padding: 0;">
                            <xAxis>
                                <CategoryAxis fx:id="profitChartDayAxis" tickLabelGap="2" />
                            </xAxis>
                            <yAxis>
